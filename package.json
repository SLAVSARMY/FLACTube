{
  "name": "flactube",
  "productName": "FLACTube",
  "version": "1.2.0",
  "description": "FLACTube (экс YT Music Desktop): YouTube Music без рекламы, скачивание треков в FLAC, автопропуск простоя",
  "main": "main.js",
  "author": "SLAVSARMY",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.flactube",
    "productName": "FLACTube",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "inject-preload.js",
      "window-preload.js",
      "renderer/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
